;; Range folds (for/sum, for*/sum, for/sum+, for*/sum+ over in-vector
;; ranges) and -I: each fold below sits in a loop that does not write
;; its array, so with -I auto it becomes a read of a table formed before
;; the loop; DRIFT writes its array in the loop and must stay a loop.
(define (v+ a b)
  (vector (+ (vector-ref a 0) (vector-ref b 0))
          (+ (vector-ref a 1) (vector-ref b 1))))
(define (m+ a b)
  (vector (v+ (vector-ref a 0) (vector-ref b 0))
          (v+ (vector-ref a 1) (vector-ref b 1))))
(define (rect-sum m r0 r1 c0 c1)
  (for*/sum ((row (in-vector m r0 r1))
             (x   (in-vector row c0 c1)))
    x))
(define (vrange vs l r)
  (for/sum+ #:zero (vector 0 0) #:add v+
    ((x (in-vector vs l r)))
    x))
(define (grid-rect grid r0 r1 c0 c1)
  (for*/sum+ #:zero (vector (vector 0 0) (vector 0 0)) #:add m+
    ((row (in-vector grid r0 r1))
     (x   (in-vector row c0 c1)))
    x))
;; every box of side w, through the kernel
(define (boxes m nr nc w)
  (let ((tot 0))
    (do ((i 0 (+ i 1))) ((> (+ i w) nr))
      (do ((j 0 (+ j 1))) ((> (+ j w) nc))
        (set! tot (+ tot (rect-sum m i (+ i w) j (+ j w))))))
    tot))
;; the same written in place, a 3-deep array
(define (cubes c n w)
  (let ((tot 0))
    (do ((i 0 (+ i 1))) ((> (+ i w) n))
      (set! tot (+ tot (for*/sum ((p (in-vector c i (+ i w)))
                                  (q (in-vector p 1 w))
                                  (x (in-vector q 0 (+ i 1))))
                         x))))
    tot))
(define (windows vs n w)
  (let ((acc (vector 0 0)))
    (do ((i 0 (+ i 1))) ((> (+ i w) n))
      (set! acc (v+ acc (vrange vs i (+ i w)))))
    acc))
(define (grid-boxes grid n)
  (let ((acc (vector (vector 0 0) (vector 0 0))))
    (do ((i 0 (+ i 1))) ((= i n))
      (set! acc (m+ acc (grid-rect grid 0 (+ i 1) i n))))
    acc))
;; moving averages: the window's bounds are expressions of the outer
;; loops (a table); the same sum over (in-range w) with the offset in the
;; subscript is not a range fold yet and stays a loop
(define (ma-sums ps nobs wmax)
  (let ((tot 0.0))
    (do ((r 0 (+ r 1))) ((= r nobs))
      (do ((w 1 (+ w 1))) ((> w wmax))
        (set! tot (+ tot (/ (for/sum ((x (in-vector ps (- (+ wmax r) (- w 1)) (+ wmax r 1)))) x)
                            w)))
        (set! tot (+ tot (/ (for/sum ((a (in-range w))) (vector-ref ps (- (+ wmax r) a)))
                            w)))))
    tot))
;; writes m in the loop: no table
(define (drift m nr nc)
  (let ((tot 0))
    (do ((i 0 (+ i 1))) ((= i nr))
      (vector-set! (vector-ref m i) 0 (+ 1 (vector-ref (vector-ref m i) 0)))
      (set! tot (+ tot (rect-sum m 0 (+ i 1) 0 nc))))
    tot))
(define (main)
  (let ((m (make-vector 12 (make-vector 9 0)))
        (c (make-vector 5 (make-vector 4 (make-vector 6 0.0))))
        (vs (make-vector 20 (vector 0 0)))
        (grid (make-vector 4 (make-vector 5 (vector (vector 0 0) (vector 0 0))))))
    (do ((i 0 (+ i 1))) ((= i 12))
      (let ((row (make-vector 9 0)))
        (do ((j 0 (+ j 1))) ((= j 9))
          (vector-set! row j (remainder (+ (* i 7) (* j 3)) 11)))
        (vector-set! m i row)))
    (do ((i 0 (+ i 1))) ((= i 5))
      (let ((pl (make-vector 4 (make-vector 6 0.0))))
        (do ((j 0 (+ j 1))) ((= j 4))
          (let ((ln (make-vector 6 0.0)))
            (do ((k 0 (+ k 1))) ((= k 6))
              (vector-set! ln k (* 0.5 (+ i (* 2 j) k))))
            (vector-set! pl j ln)))
        (vector-set! c i pl)))
    (do ((i 0 (+ i 1))) ((= i 20))
      (vector-set! vs i (vector i (* i i))))
    (do ((i 0 (+ i 1))) ((= i 4))
      (let ((row (make-vector 5 (vector (vector 0 0) (vector 0 0)))))
        (do ((j 0 (+ j 1))) ((= j 5))
          (vector-set! row j (vector (vector i j) (vector 1 (+ i j)))))
        (vector-set! grid i row)))
    (display (rect-sum m 2 7 1 5)) (newline)
    (display (boxes m 12 9 3)) (newline)
    (display (cubes c 5 2)) (newline)
    (let ((w (windows vs 20 4)))
      (display (vector-ref w 0)) (newline)
      (display (vector-ref w 1)) (newline))
    (let ((g (grid-boxes grid 4)))
      (display (vector-ref (vector-ref g 0) 0)) (newline)
      (display (vector-ref (vector-ref g 1) 1)) (newline))
    (display (for/sum ((a (in-vector (vector-ref m 1))) (b (in-vector (vector-ref m 2)))) (* a b)))
    (newline)
    (let ((ps (make-vector 50 0.0)))
      (do ((i 0 (+ i 1))) ((= i 50)) (vector-set! ps i (* 0.5 (remainder (* i 7) 13))))
      (display (ma-sums ps 40 8)) (newline))
    (display (drift m 12 9)) (newline)
    0))
