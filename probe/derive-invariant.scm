;; Products of loop-invariant arrays (rewrite-invariant.scm).  Each round
;; of SUBSETS drops one feature, gathers the rest from X (n x p) and from
;; Z (n x q, q >= p) and forms, from the gathered columns, the Gram
;; Xk'Xk, the cross product Xk'Zk and Xk'y -- and, from X and Z whole,
;; X'Z.  X, Z and y are never written in the loop, so --derive forms X'X,
;; X'Z and X'y once and takes each round's products from them by the
;; subset's indices; the fills of xk and zk go.  DRIFT does the same with
;; X changed every round, which must stay as written.  Integer data, so
;; every side prints the same digits.
(define (subsets x z y idx xk zk gk gz gy gw out rounds n p q)
  (let ((k 0) (tot 0.0))
    (do ((t 0 (+ t 1))) ((= t rounds))
      (set! k 0)
      (do ((j 0 (+ j 1))) ((= j p))
        (if (= j (remainder t p)) 0 (begin (vector-set! idx k j) (set! k (+ k 1)))))
      (do ((i 0 (+ i 1))) ((= i n))
        (do ((c 0 (+ c 1))) ((= c k))
          (vector-set! xk (+ (* i k) c) (vector-ref x (+ (* i p) (vector-ref idx c))))))
      (do ((i 0 (+ i 1))) ((= i n))
        (do ((c 0 (+ c 1))) ((= c k))
          (vector-set! zk (+ (* i k) c) (vector-ref z (+ (* i q) (vector-ref idx c))))))
      (with-arrays ((xk (n k)) (gk (k k)))
        (array-set! gk (matmul (transpose xk) xk)))
      (with-arrays ((xk (n k)) (zk (n k)) (gz (k k)))
        (array-set! gz (matmul (transpose xk) zk)))
      (with-arrays ((xk (n k)) (y (n)) (gy (k)))
        (array-set! gy (matmul (transpose xk) y)))
      (with-arrays ((x (n p)) (z (n q)) (gw (p q)))
        (array-set! gw (matmul (transpose x) z)))
      (do ((r 0 (+ r 1))) ((= r k))
        (set! tot (+ tot (* (exact->inexact (+ r t 1)) (vector-ref gy r))))
        (do ((c 0 (+ c 1))) ((= c k))
          (set! tot (+ tot (* (exact->inexact (+ r 1)) (vector-ref gk (+ (* r k) c)))))
          (set! tot (+ tot (* (exact->inexact (+ c 1)) (vector-ref gz (+ (* r k) c)))))))
      (do ((r 0 (+ r 1))) ((= r (* p q)))
        (set! tot (+ tot (vector-ref gw r))))
      (vector-set! out t tot))
    k))

(define (drift x idx xk gk out rounds n p)
  (let ((k 0) (tot 0.0))
    (do ((t 0 (+ t 1))) ((= t rounds))
      (set! k 0)
      (do ((j 0 (+ j 1))) ((= j p))
        (if (= j (remainder t p)) 0 (begin (vector-set! idx k j) (set! k (+ k 1)))))
      (do ((i 0 (+ i 1))) ((= i n))
        (do ((c 0 (+ c 1))) ((= c k))
          (vector-set! xk (+ (* i k) c) (vector-ref x (+ (* i p) (vector-ref idx c))))))
      (with-arrays ((xk (n k)) (gk (k k)) (x (n p)))
        (array-set! gk (matmul (transpose xk) xk)))
      (do ((r 0 (+ r 1))) ((= r (* k k)))
        (set! tot (+ tot (vector-ref gk r))))
      (vector-set! x (+ t 1) (+ (vector-ref x (+ t 1)) 1.0))
      (vector-set! out t tot))
    k))

(define (main)
  (let ((n 6) (p 3) (q 4) (rounds 5))
    (let ((x (vector 1.0 2.0 -1.0  0.0 1.0 3.0  -2.0 1.0 1.0  1.0 -1.0 2.0  3.0 0.0 -1.0  1.0 1.0 1.0))
          (z (vector 2.0 1.0 0.0 1.0  -1.0 3.0 1.0 2.0  0.0 1.0 -2.0 1.0
                     1.0 0.0 1.0 -1.0  2.0 2.0 1.0 0.0  -1.0 1.0 0.0 3.0))
          (y (vector 1.0 -2.0 3.0 0.0 1.0 2.0))
          (idx (make-vector 3 0))
          (xk (make-vector 18 0.0)) (zk (make-vector 18 0.0))
          (gk (make-vector 9 0.0)) (gz (make-vector 9 0.0)) (gy (make-vector 3 0.0))
          (gw (make-vector 12 0.0))
          (out (make-vector 5 0.0)))
      (display (subsets x z y idx xk zk gk gz gy gw out rounds n p q)) (newline)
      (do ((j 0 (+ j 1))) ((= j rounds)) (display (vector-ref out j)) (display " "))
      (newline)
      (do ((j 0 (+ j 1))) ((= j 4))
        (display (vector-ref gk j)) (display " ") (display (vector-ref gz j)) (display " "))
      (display (vector-ref gy 0)) (display " ") (display (vector-ref gy 1))
      (newline)
      (display (drift x idx xk gk out rounds n p)) (newline)
      (do ((j 0 (+ j 1))) ((= j rounds)) (display (vector-ref out j)) (display " "))
      (newline)
      (do ((j 0 (+ j 1))) ((= j 8)) (display (vector-ref x j)) (display " "))
      (newline))
    0))
