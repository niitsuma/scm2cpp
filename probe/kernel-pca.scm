;; kernel-pca.scm on seven points in two features.  For the rbf, the
;; polynomial, the sigmoid and the cosine kernel: the two largest
;; eigenpairs of the centred matrix by the dense route and by subspace
;; iteration (four columns; both print the same pairs, svd_flip's signs
;; making the vectors determined), then two new points centred against
;; the fit.  For the linear kernel the dense route and the p x p side.
;; Each value printed plus one, so that what rounds to zero prints
;; alike.  Plain the eigenpairs come from sym-eigen.scm and a selection;
;; under --blas from LAPACK's dsyevr.
(include "../examples/kernel-only/kernel-pca.scm")

(define (show v m)
  (do ((j 0 (+ j 1))) ((= j m))
    (display (+ 1.0 (vector-ref v j))) (display " "))
  (newline))

(define (run x y kind gamma degree coef0)
  (let ((n 7) (p 2) (nb 2) (c 2) (b 4))
    (let ((k (make-vector (* n n) 0.0))
          (k2 (make-vector (* n n) 0.0))
          (q (make-vector (* n b) 0.0))
          (vecs (make-vector (* n c) 0.0))
          (vals (make-vector c 0.0))
          (m (make-vector (+ n 1) 0.0))
          (kb (make-vector (* nb n) 0.0)))
      (kpca-kernel-self x k kind gamma degree coef0 n p)
      (kpca-centre k m n)
      (do ((s 0 (+ s 1))) ((= s (* n n))) (vector-set! k2 s (vector-ref k s)))
      (kpca-top-dense k vecs vals n c)
      (show vals c)
      (show vecs (* n c))
      (do ((s 0 (+ s 1))) ((= s (* n b)))
        (vector-set! q s (- (* 0.125 (exact->inexact (remainder (* (+ s 3) 11) 17))) 1.0)))
      (if (< (kpca-top-subspace k2 q vecs vals n b c 1e-12 500) 0)
          (begin (display "no convergence") (newline))
          (begin (show vals c) (show vecs (* n c))))
      (kpca-kernel y x kb kind gamma degree coef0 nb n p)
      (kpca-centre-new kb m nb n)
      (show kb (* nb n))
      0)))

(define (linear x)
  (let ((n 7) (p 2) (c 2))
    (let ((k (make-vector (* n n) 0.0))
          (g (make-vector (* p p) 0.0))
          (xm (make-vector p 0.0))
          (vecs (make-vector (* n c) 0.0))
          (vals (make-vector c 0.0))
          (m (make-vector (+ n 1) 0.0)))
      (kpca-kernel-self x k 0 1.0 1.0 0.0 n p)
      (kpca-centre k m n)
      (kpca-top-dense k vecs vals n c)
      (show vals c)
      (show vecs (* n c))
      (do ((j 0 (+ j 1))) ((= j p))
        (let ((acc 0.0))
          (do ((i 0 (+ i 1))) ((= i n)) (set! acc (+ acc (vector-ref x (+ (* i p) j)))))
          (vector-set! xm j (/ acc (exact->inexact n)))))
      (do ((a 0 (+ a 1))) ((= a p))
        (do ((bb 0 (+ bb 1))) ((= bb p))
          (let ((acc 0.0))
            (do ((i 0 (+ i 1))) ((= i n))
              (set! acc (+ acc (* (- (vector-ref x (+ (* i p) a)) (vector-ref xm a))
                                  (- (vector-ref x (+ (* i p) bb)) (vector-ref xm bb))))))
            (vector-set! g (+ (* a p) bb) acc))))
      (kpca-linear x xm g vecs vals n p c)
      (show vals c)
      (show vecs (* n c))
      0)))

(define (main)
  (let ((x (vector 0.31 -0.72 1.05 0.18 -0.44 0.93 0.67 -1.21 -0.09 0.52
                   1.38 -0.35 -0.81 -0.27))
        (y (make-vector (* 2 2) 0.0)))
    (vector-set! y 0 0.3) (vector-set! y 1 -0.2) (vector-set! y 2 1.1) (vector-set! y 3 0.4)
    (run x y 1 0.5 3.0 1.0)
    (run x y 2 0.5 3.0 1.0)
    (run x y 3 0.5 3.0 1.0)
    (run x y 4 0.5 3.0 1.0)
    (linear x)
    0))
