;; ridge-gcv.scm on a tall design (8 x 3, the primal: eigenvectors of
;; Xc'Xc) and a wide one (4 x 6, the dual: of Xc Xc' + 11', the
;; intercept's eigenvector unweighted), both centred, two targets,
;; three alphas.  Prints the mean squared leave-one-out
;; error per alpha and target, which no sign of an eigenvector changes,
;; and one stored squared error.  Plain the eigenproblem is
;; sym-eigen.scm's; under --blas it is LAPACK's dsyevd.
(include "../examples/kernel-only/ridge-gcv.scm")

(define (show v m)
  (do ((j 0 (+ j 1))) ((= j m))
    (display (vector-ref v j)) (display " "))
  (newline))

;; the column means of X (n x p) into XM, X left as it is; YC centred in place
(define (centre x xm yc n p t)
  (do ((j 0 (+ j 1))) ((= j p))
    (let ((acc 0.0))
      (do ((i 0 (+ i 1))) ((= i n)) (set! acc (+ acc (vector-ref x (+ (* i p) j)))))
      (vector-set! xm j (/ acc (exact->inexact n)))))
  (do ((j 0 (+ j 1))) ((= j t))
    (let ((acc 0.0))
      (do ((i 0 (+ i 1))) ((= i n)) (set! acc (+ acc (vector-ref yc (+ (* i t) j)))))
      (do ((i 0 (+ i 1))) ((= i n))
        (vector-set! yc (+ (* i t) j) (- (vector-ref yc (+ (* i t) j)) (/ acc (exact->inexact n)))))))
  0)

(define (primal alphas t na)
    (let ((n 8) (p 3))
     (let ((x (make-vector (* n p) 0.0)) (xm (make-vector p 0.0)) (yc (make-vector (* n t) 0.0)))
      (do ((q 0 (+ q 1))) ((= q (* n p)))
        (vector-set! x q (+ 0.25 (exact->inexact (remainder (* (+ q 3) 7) 11)))))
      (do ((i 0 (+ i 1))) ((= i n))
        (vector-set! yc (* i t) (+ (vector-ref x (* i p)) (* 0.5 (exact->inexact (remainder (* i 5) 3)))))
        (vector-set! yc (+ (* i t) 1) (- (vector-ref x (+ (* i p) 2)) (exact->inexact (remainder i 2)))))
      (centre x xm yc n p t)
      (let ((g (make-vector (* p p) 0.0)) (v (make-vector (* p p) 0.0)) (lam (make-vector p 0.0))
            (z (make-vector (* n p) 0.0)) (r (make-vector (* p t) 0.0))
            (mse (make-vector (* na t) 0.0)) (loo (make-vector (* (* n t) na) 0.0)))
        ;; the centred Gram, by loops
        (do ((a 0 (+ a 1))) ((= a p))
          (do ((b 0 (+ b 1))) ((= b p))
            (let ((acc 0.0))
              (do ((i 0 (+ i 1))) ((= i n))
                (set! acc (+ acc (* (- (vector-ref x (+ (* i p) a)) (vector-ref xm a))
                                    (- (vector-ref x (+ (* i p) b)) (vector-ref xm b))))))
              (vector-set! g (+ (* a p) b) acc))))
        (ridge-gcv-primal x xm yc g v lam z r n p t)
        (ridge-gcv-scan z lam r yc alphas (/ 1.0 (exact->inexact n)) mse loo 1 n p t na)
        (show mse (* na t))
        (display (vector-ref loo 7)) (newline)
        0))))

(define (dual alphas t na)
    (let ((n 4) (p 6))
     (let ((x (make-vector (* n p) 0.0)) (xm (make-vector p 0.0)) (yc (make-vector (* n t) 0.0)))
      (do ((q 0 (+ q 1))) ((= q (* n p)))
        (vector-set! x q (- (exact->inexact (remainder (* (+ q 1) 5) 9)) 3.5)))
      (do ((i 0 (+ i 1))) ((= i n))
        (vector-set! yc (* i t) (+ (vector-ref x (* i p)) (vector-ref x (+ (* i p) 3))))
        (vector-set! yc (+ (* i t) 1) (* 0.5 (exact->inexact (- (* i i) 2)))))
      (centre x xm yc n p t)
      (let ((k (make-vector (* n n) 0.0)) (q (make-vector (* n n) 0.0)) (mu (make-vector n 0.0))
            (r (make-vector (* n t) 0.0))
            (mse (make-vector (* na t) 0.0)) (loo (make-vector (* (* n t) na) 0.0)))
        (do ((a 0 (+ a 1))) ((= a n))
          (do ((b 0 (+ b 1))) ((= b n))
            (let ((acc 0.0))
              (do ((j 0 (+ j 1))) ((= j p))
                (set! acc (+ acc (* (- (vector-ref x (+ (* a p) j)) (vector-ref xm j))
                                    (- (vector-ref x (+ (* b p) j)) (vector-ref xm j))))))
              (vector-set! k (+ (* a n) b) (+ acc 1.0)))))
        (ridge-gcv-scan-dual q mu r alphas (ridge-gcv-dual k q mu yc r n t 1) mse loo 1 n t na)
        (show mse (* na t))
        (display (vector-ref loo 5)) (newline)
        0))))

(define (main)
  (let ((alphas (make-vector (+ 1 2) 0.0)))
    (vector-set! alphas 0 0.5) (vector-set! alphas 1 2.0) (vector-set! alphas 2 8.0)
    ;; primal: n = 8, p = 3; dual: n = 4, p = 6
    (primal alphas 2 3)
    (dual alphas 2 3)
    0))
